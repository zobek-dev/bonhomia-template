{% comment %}
  Renders facets (filtering and sorting) — Bonhomia chip-based PLP toolbar.

  Accepts:
  - results: {Object} Collection or Search object
  - enable_filtering: {Boolean} Show filtering when true
  - enable_sorting: {Boolean} Show sorting when true
  - filter_type: {String} Kept for compatibility; this snippet always renders horizontal chips.
  - paginate: {Object}

  IMPORTANT: All Dawn AJAX hooks are preserved unchanged:
    - <facet-filters-form> custom element
    - form IDs: FacetFiltersForm, FacetFiltersFormMobile, FacetSortForm-style sort selects (SortBy / SortBy-mobile)
    - input names use {{ value.param_name }} / sort_by
    - <details> wrappers carry id="Details-{{ filter.param_name }}-{{ section.id }}" and data-index="{{ forloop.index }}"
    - <facet-remove> wrappers used by facets.js to swap pills
  Only the visible markup/classes change. Do not rename IDs or input names.
{% endcomment %}

{{ 'component-show-more.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
-%}

<div class="bh-facets{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  {%- comment -%} Desktop / tablet — horizontal chip bar {%- endcomment -%}
  <facet-filters-form class="bh-facets__desktop small-hide">
    <form id="FacetFiltersForm" class="facets__form bh-facets__form tw-flex tw-flex-col tw-gap-4">
      {%- if results.terms -%}
        <input type="hidden" name="q" value="{{ results.terms | escape }}">
        <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}

      {% if results.current_vendor or results.current_type %}
        <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
      {% endif %}

      <div class="tw-flex tw-flex-col md:tw-flex-row md:tw-items-start md:tw-justify-between tw-gap-4">
        {%- if enable_filtering -%}
          <div
            id="FacetsWrapperDesktop"
            class="facets__wrapper bh-facets__chips tw-flex tw-flex-wrap tw-items-center tw-gap-2 md:tw-flex-1"
          >
            <h2 class="facets__heading eyebrow tw-mr-2 tw-mb-0" id="verticalTitle" tabindex="-1">
              {{ 'products.facets.filter_by_label' | t }}
            </h2>

            {%- comment -%} Optional shortcut chips: link to compra directa / a medida {%- endcomment -%}
            {%- assign current_handle = results.handle | default: '' -%}
            {%- if current_handle != 'disponible' and current_handle != 'a-medida' -%}
              {%- assign direct_url = routes.collections_url | append: '/disponible' -%}
              {%- assign assisted_url = routes.collections_url | append: '/a-medida' -%}
              <a
                href="{{ direct_url }}"
                class="filter-chip"
                data-bh-shortcut="direct"
              >
                Compra directa
              </a>
              <a
                href="{{ assisted_url }}"
                class="filter-chip"
                data-bh-shortcut="assisted"
              >
                A medida
              </a>
            {%- endif -%}

            {%- for filter in results.filters -%}
              {%- liquid
                assign presentation = filter.presentation | default: 'text'
              -%}

              {% case filter.type %}
                {% when 'boolean', 'list' %}
                  <details
                    id="Details-{{ filter.param_name | escape }}-{{ section.id }}"
                    class="bh-facets__group disclosure-has-popup js-filter tw-relative"
                    data-index="{{ forloop.index }}"
                  >
                    <summary
                      class="filter-chip facets__summary tw-list-none tw-cursor-pointer"
                      aria-label="{{ filter.label | escape }} ({{ 'products.facets.filters_selected.one' | t: count: filter.active_values.size }})"
                    >
                      <span class="facets__summary-label tw-flex tw-items-center tw-gap-1">
                        {{- filter.label | escape -}}
                        {%- if filter.active_values.size > 0 -%}
                          <span class="tw-ml-1 tw-bg-charcoal tw-text-warm-white tw-rounded-pill tw-text-[10px] tw-px-1.5 tw-py-0.5">
                            {{ filter.active_values.size }}
                          </span>
                        {%- endif -%}
                        <span class="svg-wrapper tw-inline-flex tw-items-center tw-ml-1">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </span>
                    </summary>

                    <div
                      id="Facet-{{ forloop.index }}-{{ section.id }}"
                      class="parent-display facets__display bh-facets__popover tw-absolute tw-top-full tw-left-0 tw-z-30 tw-mt-2 tw-min-w-[260px] tw-bg-warm-white tw-border tw-border-border-soft tw-rounded-md tw-shadow-lg tw-p-4"
                    >
                      <div class="facets__header tw-flex tw-items-center tw-justify-between tw-mb-3 tw-pb-2 tw-border-b tw-border-border-soft">
                        <div>
                          <span class="facets__selected tw-text-xs tw-text-taupe">
                            {{- 'products.facets.filters_selected' | t: count: filter.active_values.size -}}
                          </span>
                          {%- if filter.operator == 'AND' -%}
                            <span class="facets__and-helptext tw-block tw-text-xs tw-text-taupe">
                              {{ 'products.facets.filter_and_operator_subtitle' | t }}
                            </span>
                          {%- endif -%}
                        </div>
                        <facet-remove>
                          <a href="{{ filter.url_to_remove }}" class="facets__reset tw-text-xs tw-text-accent tw-underline">
                            {{ 'products.facets.reset' | t }}
                          </a>
                        </facet-remove>
                      </div>

                      <fieldset class="facets-wrap parent-wrap tw-border-0 tw-p-0 tw-m-0">
                        <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                        {%- liquid
                          assign sorted_values = filter.values
                          if filter.operator == 'AND'
                            assign active_filter_values = filter.values | where: 'active', true
                            assign inactive_filter_values = filter.values | where: 'active', false
                            assign sorted_values = active_filter_values | concat: inactive_filter_values
                          endif
                        -%}
                        <ul
                          class="facets__list list-unstyled tw-flex tw-flex-wrap tw-gap-2 tw-list-none tw-p-0 tw-m-0"
                          role="list"
                        >
                          {%- for value in sorted_values -%}
                            {% liquid
                              assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-' | append: forloop.index
                              assign is_disabled = false
                              if value.count == 0 and value.active == false
                                assign is_disabled = true
                              endif
                            %}
                            <li class="list-menu__item facets__item tw-m-0 tw-p-0">
                              {%- if presentation == 'swatch' -%}
                                <div class="facets__label facet-checkbox tw-inline-flex tw-items-center tw-gap-2{% if is_disabled %} tw-opacity-50{% endif %}">
                                  <div class="swatch-input-wrapper">
                                    {% render 'swatch-input',
                                      id: input_id,
                                      type: 'checkbox',
                                      name: value.param_name,
                                      value: value.value,
                                      product_form_id: 'FacetFiltersForm',
                                      swatch: value.swatch,
                                      checked: value.active,
                                      disabled: is_disabled
                                    %}
                                  </div>
                                  <span class="facet-checkbox__text">
                                    <span class="facet-checkbox__text-label">{{- value.label | escape }}</span>
                                    <span class="tw-text-taupe"> ({{ value.count }})</span>
                                  </span>
                                </div>
                              {%- else -%}
                                <label
                                  for="{{ input_id }}"
                                  class="filter-chip facets__label facet-checkbox{% if is_disabled %} tw-opacity-50 tw-cursor-not-allowed{% endif %}{% if value.active %} active{% endif %}"
                                  {% if value.active %}aria-pressed="true"{% endif %}
                                >
                                  <input
                                    class="tw-sr-only"
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    id="{{ input_id }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if is_disabled %}disabled{% endif %}
                                  >
                                  <span class="facet-checkbox__text">
                                    <span class="facet-checkbox__text-label">{{- value.label | escape }}</span>
                                    <span class="tw-text-taupe tw-ml-1">({{ value.count }})</span>
                                  </span>
                                  <span class="visually-hidden">
                                    {{- value.label | escape }} (
                                    {%- if value.count == 1 -%}
                                      {{- 'products.facets.product_count_simple.one' | t: count: value.count -}}
                                    {%- else -%}
                                      {{- 'products.facets.product_count_simple.other' | t: count: value.count -}}
                                    {%- endif -%}
                                    )
                                  </span>
                                </label>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </fieldset>
                    </div>
                  </details>
                {% when 'price_range' %}
                  <details
                    id="Details-{{ filter.param_name | escape }}-{{ section.id }}"
                    class="bh-facets__group disclosure-has-popup js-filter tw-relative"
                    data-index="{{ forloop.index }}"
                  >
                    <summary class="filter-chip facets__summary tw-list-none tw-cursor-pointer">
                      <span class="tw-flex tw-items-center tw-gap-1">
                        {{ filter.label | escape }}
                        <span class="svg-wrapper tw-inline-flex tw-items-center tw-ml-1">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </span>
                    </summary>
                    <div
                      id="Facet-{{ forloop.index }}-{{ section.id }}"
                      class="facets__display bh-facets__popover tw-absolute tw-top-full tw-left-0 tw-z-30 tw-mt-2 tw-min-w-[260px] tw-bg-warm-white tw-border tw-border-border-soft tw-rounded-md tw-shadow-lg tw-p-4"
                    >
                      <div class="facets__header tw-flex tw-items-center tw-justify-between tw-mb-3">
                        {%- assign max_price_amount = filter.range_max | money | strip_html | escape -%}
                        <span class="facets__selected tw-text-xs tw-text-taupe">
                          {{- 'products.facets.max_price' | t: price: max_price_amount -}}
                        </span>
                        <facet-remove>
                          <a href="{{ filter.url_to_remove }}" class="facets__reset tw-text-xs tw-text-accent tw-underline">
                            {{ 'products.facets.reset' | t }}
                          </a>
                        </facet-remove>
                      </div>
                      <price-range class="facets__price">
                        {% render 'price-facet', filter: filter, id_prefix: 'Filter-', filter_type: 'horizontal' %}
                      </price-range>
                    </div>
                  </details>
              {% endcase %}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if enable_sorting -%}
          <div class="bh-facets__sort facet-filters sorting caption tw-flex tw-items-center tw-gap-2 tw-shrink-0">
            <label for="SortBy" class="eyebrow tw-mb-0">{{ 'products.facets.sort_by_label' | t }}</label>
            <div class="select tw-relative">
              {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
              <select
                name="sort_by"
                class="facet-filters__sort select__select option-chip tw-pr-8 tw-appearance-none tw-cursor-pointer"
                id="SortBy"
                aria-describedby="a11y-refresh-page-message"
              >
                {%- for option in results.sort_options -%}
                  <option
                    value="{{ option.value | escape }}"
                    {% if option.value == sort_by %}selected="selected"{% endif %}
                  >
                    {{ option.name | escape }}
                  </option>
                {%- endfor -%}
              </select>
              <span class="svg-wrapper tw-absolute tw-right-2 tw-top-1/2 -tw-translate-y-1/2 tw-pointer-events-none">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Active facet pills (removable) {%- endcomment -%}
      {%- if enable_filtering -%}
        <div class="active-facets active-facets-desktop tw-flex tw-flex-wrap tw-items-center tw-gap-2">
          {%- assign has_active = false -%}
          {%- for filter in results.filters -%}
            {%- for value in filter.active_values -%}
              {%- assign has_active = true -%}
              <facet-remove>
                <a href="{{ value.url_to_remove }}" class="active-facets__button filter-chip" aria-pressed="true">
                  <span class="active-facets__button-inner tw-inline-flex tw-items-center tw-gap-1">
                    {{ filter.label | escape }}: {{ value.label | escape }}
                    <span class="svg-wrapper tw-inline-flex">
                      {{- 'icon-close-small.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                  </span>
                </a>
              </facet-remove>
            {%- endfor -%}
            {% if filter.type == 'price_range' %}
              {% assign min = filter.min_value.value %}
              {% assign max = filter.max_value.value %}
              {%- if min != null or max != null -%}
                {%- assign has_active = true -%}
                <facet-remove>
                  <a href="{{ filter.url_to_remove }}" class="active-facets__button filter-chip" aria-pressed="true">
                    <span class="active-facets__button-inner tw-inline-flex tw-items-center tw-gap-1">
                      {{ min | default: 0 | money }} - {{ max | default: filter.range_max | money }}
                      <span class="svg-wrapper tw-inline-flex">
                        {{- 'icon-close-small.svg' | inline_asset_content -}}
                      </span>
                    </span>
                  </a>
                </facet-remove>
              {%- endif -%}
            {% endif %}
          {%- endfor -%}
          {%- if has_active -%}
            <facet-remove class="active-facets__button-wrapper">
              <a href="{{ results_url }}" class="active-facets__button-remove tw-text-xs tw-text-accent tw-underline tw-ml-2">
                <span>{{ 'products.facets.clear_all' | t }}</span>
              </a>
            </facet-remove>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-count light tw-text-xs tw-text-taupe small-hide" role="status">
        <span id="ProductCountDesktop">
          {%- if results.results_count -%}
            {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
          {%- elsif results.products_count == results.all_products_count -%}
            {{ 'products.facets.product_count_simple' | t: count: results.products_count }}
          {%- else -%}
            {{
              'products.facets.product_count'
              | t: product_count: results.products_count, count: results.all_products_count
            }}
          {%- endif -%}
        </span>
        {%- render 'loading-spinner' -%}
      </div>
    </form>
  </facet-filters-form>

  {%- comment -%} Mobile drawer — simplified, same input names so AJAX still applies {%- endcomment -%}
  <menu-drawer class="mobile-facets__wrapper medium-hide large-up-hide" data-breakpoint="mobile">
    <details class="mobile-facets__disclosure disclosure-has-popup">
      <summary class="mobile-facets__open-wrapper focus-offset">
        <span class="mobile-facets__open filter-chip">
          <span class="svg-wrapper tw-mr-1">
            {{- 'icon-filter.svg' | inline_asset_content -}}
          </span>
          <span class="mobile-facets__open-label">
            {%- if enable_filtering and enable_sorting -%}
              {{ 'products.facets.filter_and_sort' | t }}
            {%- elsif enable_filtering -%}
              {{ 'products.facets.filter_button' | t }}
            {%- elsif enable_sorting -%}
              {{ 'products.facets.sort_button' | t }}
            {%- endif -%}
          </span>
        </span>
        <span tabindex="0" class="mobile-facets__close">
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </span>
      </summary>
      <facet-filters-form>
        <form id="FacetFiltersFormMobile" class="mobile-facets">
          <div class="mobile-facets__inner gradient">
            <div class="mobile-facets__header">
              <div class="mobile-facets__header-inner">
                <h2 class="mobile-facets__heading tw-font-serif tw-text-xl">
                  {%- if enable_filtering and enable_sorting -%}
                    {{ 'products.facets.filter_and_sort' | t }}
                  {%- elsif enable_filtering -%}
                    {{ 'products.facets.filter_button' | t }}
                  {%- elsif enable_sorting -%}
                    {{ 'products.facets.sort_button' | t }}
                  {%- endif -%}
                </h2>
                <p class="mobile-facets__count tw-text-xs tw-text-taupe">
                  {%- if results.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
                  {%- elsif results.products_count == results.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: results.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: results.products_count, count: results.all_products_count
                    }}
                  {%- endif -%}
                </p>
              </div>
            </div>
            <div id="FacetsWrapperMobile" class="mobile-facets__main has-submenu gradient">
              {%- if enable_filtering -%}
                {%- for filter in results.filters -%}
                  {%- liquid
                    assign presentation = filter.presentation | default: 'text'
                  -%}
                  {% case filter.type %}
                    {% when 'boolean', 'list' %}
                      <details
                        id="Details-Mobile-{{ filter.param_name | escape }}-{{ section.id }}"
                        class="mobile-facets__details js-filter"
                        data-index="mobile-{{ forloop.index }}"
                      >
                        <summary class="mobile-facets__summary focus-inset">
                          <div>
                            <span>{{ filter.label | escape }}</span>
                            <span class="mobile-facets__arrow">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                          </div>
                        </summary>
                        <div id="FacetMobile-{{ forloop.index }}-{{ section.id }}" class="mobile-facets__submenu gradient">
                          <button
                            class="mobile-facets__close-button link link--text focus-inset"
                            aria-expanded="true"
                            type="button"
                          >
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                            <span>{{ filter.label | escape }}</span>
                          </button>
                          <ul class="mobile-facets__list list-unstyled tw-flex tw-flex-wrap tw-gap-2 tw-p-4" role="list">
                            {%- for value in filter.values -%}
                              {% liquid
                                assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-mobile-' | append: forloop.index
                                assign is_disabled = false
                                if value.count == 0 and value.active == false
                                  assign is_disabled = true
                                endif
                              %}
                              <li class="mobile-facets__item list-menu__item">
                                {% if presentation == 'swatch' %}
                                  <div class="facets__label mobile-facets__label tw-inline-flex tw-items-center tw-gap-2{% if is_disabled %} tw-opacity-50{% endif %}{% if value.active %} active{% endif %}">
                                    <div class="swatch-input-wrapper">
                                      {% render 'swatch-input',
                                        id: input_id,
                                        type: 'checkbox',
                                        name: value.param_name,
                                        value: value.value,
                                        product_form_id: 'FacetFiltersFormMobile',
                                        swatch: value.swatch,
                                        checked: value.active,
                                        disabled: is_disabled
                                      %}
                                    </div>
                                    <span class="facet-checkbox__text">
                                      <span class="facet-checkbox__text-label">{{- value.label | escape }}</span> ({{- value.count -}})
                                    </span>
                                  </div>
                                {% else %}
                                  <label
                                    for="{{ input_id }}"
                                    class="filter-chip mobile-facets__label{% if is_disabled %} tw-opacity-50{% endif %}{% if value.active %} active{% endif %}"
                                    {% if value.active %}aria-pressed="true"{% endif %}
                                  >
                                    <input
                                      class="mobile-facets__checkbox tw-sr-only"
                                      type="checkbox"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value }}"
                                      id="{{ input_id }}"
                                      {% if value.active %}checked{% endif %}
                                      {% if is_disabled %}disabled{% endif %}
                                    >
                                    <span class="facet-checkbox__text">
                                      <span class="facet-checkbox__text-label">{{- value.label | escape }}</span>
                                      <span class="tw-text-taupe tw-ml-1">({{ value.count }})</span>
                                    </span>
                                  </label>
                                {% endif %}
                              </li>
                            {%- endfor -%}
                          </ul>
                          <div class="mobile-facets__footer gradient">
                            <facet-remove class="mobile-facets__clear-wrapper">
                              <a href="{{ filter.url_to_remove }}" class="mobile-facets__clear tw-text-accent tw-underline">
                                {{- 'products.facets.clear' | t -}}
                              </a>
                            </facet-remove>
                            <button
                              type="button"
                              class="btn-primary"
                              onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
                            >
                              {{ 'products.facets.apply' | t }}
                            </button>
                          </div>
                        </div>
                      </details>
                    {% when 'price_range' %}
                      <details
                        id="Details-Mobile-{{ filter.param_name | escape }}-{{ section.id }}"
                        class="mobile-facets__details js-filter"
                        data-index="mobile-{{ forloop.index }}"
                      >
                        <summary class="mobile-facets__summary focus-inset">
                          <div>
                            <span>{{ filter.label | escape }}</span>
                            <span class="mobile-facets__arrow">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                          </div>
                        </summary>
                        <div id="FacetMobile-{{ forloop.index }}-{{ section.id }}" class="mobile-facets__submenu gradient">
                          <button
                            class="mobile-facets__close-button link link--text focus-inset"
                            aria-expanded="true"
                            type="button"
                          >
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                            {{ filter.label | escape }}
                          </button>
                          {%- assign max_price_amount = filter.range_max | money | strip_html | escape -%}
                          <p class="mobile-facets__info">
                            {{ 'products.facets.max_price' | t: price: max_price_amount }}
                          </p>
                          <price-range class="facets__price">
                            {% render 'price-facet', filter: filter, id_prefix: 'Mobile-Filter-' %}
                          </price-range>
                          <div class="mobile-facets__footer">
                            <facet-remove class="mobile-facets__clear-wrapper">
                              <a href="{{ filter.url_to_remove }}" class="mobile-facets__clear tw-text-accent tw-underline">
                                {{- 'products.facets.clear' | t -}}
                              </a>
                            </facet-remove>
                            <button
                              type="button"
                              class="btn-primary"
                              onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
                            >
                              {{ 'products.facets.apply' | t }}
                            </button>
                          </div>
                        </div>
                      </details>
                  {% endcase %}
                {%- endfor -%}
              {%- endif -%}

              {%- if enable_sorting -%}
                <div
                  id="Details-Mobile-SortBy-{{ section.id }}"
                  class="mobile-facets__details js-filter"
                  data-index="mobile-sort"
                >
                  <div class="mobile-facets__summary">
                    <div class="mobile-facets__sort">
                      <label for="SortBy-mobile" class="eyebrow">{{ 'products.facets.sort_by_label' | t }}</label>
                      <div class="select">
                        <select
                          name="sort_by"
                          class="select__select option-chip"
                          id="SortBy-mobile"
                          aria-describedby="a11y-refresh-page-message"
                        >
                          {%- for option in results.sort_options -%}
                            <option
                              value="{{ option.value | escape }}"
                              {% if option.value == sort_by %}selected="selected"{% endif %}
                            >
                              {{ option.name | escape }}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              <div class="mobile-facets__footer">
                <facet-remove class="mobile-facets__clear-wrapper">
                  <a href="{{ results_url }}" class="mobile-facets__clear tw-text-accent tw-underline">
                    {{- 'products.facets.clear_all' | t -}}
                  </a>
                </facet-remove>
                <button
                  type="button"
                  class="btn-primary"
                  onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
                >
                  {{ 'products.facets.apply' | t }}
                </button>
              </div>
            </div>

            {% if results.current_vendor or results.current_type %}
              <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
            {% endif %}

            {%- if results.terms -%}
              <input type="hidden" name="q" value="{{ results.terms | escape }}">
              <input name="options[prefix]" type="hidden" value="last">
            {%- endif -%}
          </div>
        </form>
      </facet-filters-form>
    </details>
  </menu-drawer>

  <div class="active-facets active-facets-mobile medium-hide large-up-hide tw-flex tw-flex-wrap tw-gap-2 tw-mt-2">
    {%- for filter in results.filters -%}
      {%- for value in filter.active_values -%}
        <facet-remove>
          <a href="{{ value.url_to_remove }}" class="active-facets__button filter-chip" aria-pressed="true">
            <span class="active-facets__button-inner tw-inline-flex tw-items-center tw-gap-1">
              {{ filter.label | escape }}: {{ value.label | escape }}
              <span class="svg-wrapper tw-inline-flex">
                {{- 'icon-close-small.svg' | inline_asset_content -}}
              </span>
            </span>
          </a>
        </facet-remove>
      {%- endfor -%}
    {%- endfor -%}
  </div>

  <div class="product-count light tw-text-xs tw-text-taupe medium-hide large-up-hide tw-mt-2" role="status">
    <span id="ProductCount">
      {%- if results.results_count -%}
        {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
      {%- elsif results.products_count == results.all_products_count -%}
        {{ 'products.facets.product_count_simple' | t: count: results.products_count }}
      {%- else -%}
        {{
          'products.facets.product_count'
          | t: product_count: results.products_count, count: results.all_products_count
        }}
      {%- endif -%}
    </span>
    {%- render 'loading-spinner' -%}
  </div>
</div>

{% comment %}
  Renders cart notification (Bonhomia re-skin)

  Conserva Dawn AJAX:
  - <cart-notification>, id="cart-notification", id="cart-notification-product",
    id="cart-notification-button", id="cart-notification-form".
  - .cart-notification__close (listener en cart-notification.js).
  - El estilo display:none al inicio se mantiene; cart-notification.js conmuta
    la visibilidad agregando la clase `active`.

  Accepts:
  - color_scheme: {String}
  - desktop_menu_type: {String}
{% endcomment %}

<cart-notification>
  <div class="cart-notification-wrapper tw-fixed tw-top-20 tw-right-4 sm:tw-right-6 tw-z-[400] tw-w-[min(380px,calc(100vw-2rem))]{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification focus-inset tw-bg-warm-white tw-border tw-border-border-soft tw-rounded-sm tw-shadow-lg tw-p-5 tw-flex tw-flex-col tw-gap-4"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      role="dialog"
      tabindex="-1"
    >
      <div class="cart-notification__header tw-flex tw-items-center tw-justify-between tw-gap-3">
        <h2 class="cart-notification__heading caption-large text-body tw-flex tw-items-center tw-gap-2 tw-text-sm tw-font-sans tw-font-medium tw-text-sage tw-m-0">
          <span class="tw-inline-flex tw-w-4 tw-h-4">
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
          </span>
          {{ 'general.cart.item_added' | t }}
        </h2>
        <button
          type="button"
          class="cart-notification__close modal__close-button link link--text focus-inset tw-bg-transparent tw-border-0 tw-text-taupe hover:tw-text-charcoal tw-cursor-pointer tw-p-1"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper tw-block tw-w-4 tw-h-4">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <div id="cart-notification-product" class="cart-notification-product tw-flex tw-gap-3 tw-items-start"></div>

      <div class="cart-notification__links tw-flex tw-flex-col tw-gap-2">
        <form action="{{ routes.cart_url }}" method="post" id="cart-notification-form" class="tw-m-0">
          <button class="button button--primary button--full-width btn-primary tw-w-full" name="checkout">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>
        <a
          href="{{ routes.cart_url }}"
          id="cart-notification-button"
          class="button button--secondary button--full-width btn-outline tw-w-full"
        >
          {{- 'general.cart.view_empty_cart' | t -}}
        </a>
        <button type="button" class="link button-label btn-ghost tw-w-full tw-justify-center">
          {{ 'general.continue_shopping' | t }}
        </button>
      </div>
    </div>
  </div>
</cart-notification>

{% style %}
  .cart-notification { display: none; }
{% endstyle %}

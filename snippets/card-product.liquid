{% comment %}
  Bonhomia product card (Phase 2).

  Accepts (Dawn-compatible signature; not all are used by Bonhomia design):
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} 'square' | 'portrait' | 'adapt'. Default 'square'.
  - image_shape: {String} ignored — Bonhomia uses flat rectangles.
  - show_secondary_image: {Boolean} swap image on hover. Default false.
  - show_vendor: {Boolean} Show product vendor as label. Default false.
  - show_rating: {Boolean} ignored.
  - extend_height: {Boolean} ignored.
  - lazy_load: {Boolean} Image lazy loading. Default true.
  - skip_styles: {Boolean} ignored — no extra stylesheets injected here.
  - quick_add: {String} ignored — Bonhomia CTA is link-only.
  - section_id: {String} optional, kept for parity.
  - horizontal_class: {Boolean} ignored.
  - horizontal_quick_add: {Boolean} ignored.
  - placeholder_image: {String} placeholder name when no product.
  - quantity_selector: {Boolean} ignored.

  Reads metafields:
  - product.metafields.bonhomia.purchase_type ('direct' | 'assisted'). Default 'direct'.
  - product.metafields.bonhomia.starting_price (money) — used for assisted "Desde $X".
{% endcomment %}

{%- liquid
  assign ratio_setting = media_aspect_ratio | default: 'square'
  assign aspect_class = 'tw-aspect-square'
  if ratio_setting == 'portrait'
    assign aspect_class = 'tw-aspect-[4/5]'
  endif
-%}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign purchase_type = card_product.metafields.bonhomia.purchase_type.value | default: 'direct'
    assign is_assisted = false
    if purchase_type == 'assisted'
      assign is_assisted = true
    endif

    assign starting_price = card_product.metafields.bonhomia.starting_price.value

    assign category_label = ''
    if show_vendor and card_product.vendor != blank
      assign category_label = card_product.vendor
    elsif card_product.type != blank
      assign category_label = card_product.type
    endif
  -%}

  <article
    class="product-card tw-group tw-flex tw-flex-col tw-h-full tw-bg-warm-white tw-rounded-md tw-overflow-hidden tw-border tw-border-border-soft tw-transition-shadow hover:tw-shadow-lg"
    id="card-{{ section_id }}-{{ card_product.id }}"
  >
    <a href="{{ card_product.url }}" class="tw-relative tw-block {{ aspect_class }} tw-overflow-hidden tw-bg-cream">
      <span class="tw-absolute tw-top-3 tw-left-3 tw-z-[2]">
        {%- if is_assisted -%}
          <span class="badge-assisted">A medida</span>
        {%- else -%}
          <span class="badge-direct">En stock</span>
        {%- endif -%}
      </span>

      {%- if card_product.featured_media -%}
        <img
          srcset="
            {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
            {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
            {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
          "
          src="{{ card_product.featured_media | image_url: width: 533 }}"
          sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
          alt="{{ card_product.featured_media.alt | escape }}"
          width="{{ card_product.featured_media.width }}"
          height="{{ card_product.featured_media.height }}"
          {% unless lazy_load == false %}loading="lazy"{% endunless %}
          class="tw-w-full tw-h-full tw-object-cover tw-transition-transform tw-duration-500 group-hover:tw-scale-105"
        >
        {%- if show_secondary_image and card_product.media[1] != null -%}
          <img
            src="{{ card_product.media[1] | image_url: width: 533 }}"
            alt="{{ card_product.media[1].alt | escape }}"
            width="{{ card_product.media[1].width }}"
            height="{{ card_product.media[1].height }}"
            loading="lazy"
            class="tw-absolute tw-inset-0 tw-w-full tw-h-full tw-object-cover tw-opacity-0 group-hover:tw-opacity-100 tw-transition-opacity tw-duration-500"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-cover placeholder-svg' }}
      {%- endif -%}
    </a>

    <div class="tw-flex tw-flex-col tw-flex-1 tw-p-5">
      {%- if category_label != blank -%}
        <p class="eyebrow tw-mb-2 tw-text-xs">{{ category_label | escape }}</p>
      {%- endif -%}

      <h3 class="tw-font-serif tw-text-charcoal tw-text-lg tw-font-medium tw-leading-snug tw-mb-2">
        <a href="{{ card_product.url }}" class="tw-text-charcoal hover:tw-text-walnut">{{ card_product.title | escape }}</a>
      </h3>

      {%- if card_product.description != blank -%}
        <p class="tw-font-sans tw-text-sm tw-text-taupe tw-leading-relaxed tw-mb-4 tw-line-clamp-2">
          {{- card_product.description | strip_html | truncate: 90 -}}
        </p>
      {%- endif -%}

      <div class="tw-mt-auto tw-flex tw-items-center tw-justify-between tw-gap-3 tw-mb-4">
        <p class="tw-font-sans tw-text-base tw-text-charcoal tw-m-0">
          {%- if is_assisted -%}
            {%- if starting_price -%}
              <span class="tw-text-taupe tw-text-sm">Desde </span><strong class="tw-text-charcoal tw-font-semibold">{{ starting_price | money }}</strong>
            {%- else -%}
              <span class="tw-text-taupe tw-text-sm">Cotización gratuita</span>
            {%- endif -%}
          {%- else -%}
            <strong class="tw-text-charcoal tw-font-semibold">{{ card_product.price | money }}</strong>
            {%- if card_product.compare_at_price > card_product.price -%}
              <span class="tw-text-taupe tw-text-sm tw-line-through tw-ml-2">{{ card_product.compare_at_price | money }}</span>
            {%- endif -%}
          {%- endif -%}
        </p>
      </div>

      <a
        href="{{ card_product.url }}"
        class="{% if is_assisted %}btn-accent{% else %}btn-outline{% endif %} tw-w-full"
      >
        {%- if is_assisted -%}Cotizar{%- else -%}Ver detalle{%- endif -%}
      </a>
    </div>
  </article>
{%- else -%}
  <article class="product-card tw-flex tw-flex-col tw-h-full tw-bg-warm-white tw-rounded-md tw-overflow-hidden tw-border tw-border-border-soft">
    <div class="tw-relative tw-block {{ aspect_class }} tw-bg-cream">
      {%- if placeholder_image -%}
        {{ placeholder_image | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-cover placeholder-svg' }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-cover placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="tw-flex tw-flex-col tw-p-5">
      <h3 class="tw-font-serif tw-text-charcoal tw-text-lg tw-font-medium tw-mb-2">
        {{ 'onboarding.product_title' | t }}
      </h3>
      <p class="tw-font-sans tw-text-sm tw-text-taupe tw-mb-4">$0,00</p>
      <span class="btn-outline tw-w-full" role="link" aria-disabled="true">Ver detalle</span>
    </div>
  </article>
{%- endif -%}

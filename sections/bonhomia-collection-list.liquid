{%- liquid
  assign cols = section.settings.columns_desktop | default: 3
  assign cols_mobile = section.settings.columns_mobile | default: '1'
  assign grid_cols_desktop = 'md:tw-grid-cols-3'
  case cols
    when 1
      assign grid_cols_desktop = 'md:tw-grid-cols-1'
    when 2
      assign grid_cols_desktop = 'md:tw-grid-cols-2'
    when 3
      assign grid_cols_desktop = 'md:tw-grid-cols-3'
    when 4
      assign grid_cols_desktop = 'md:tw-grid-cols-4'
  endcase
  assign grid_cols_mobile = 'tw-grid-cols-1'
  if cols_mobile == '2'
    assign grid_cols_mobile = 'tw-grid-cols-2'
  endif
  assign view_all_href = section.settings.view_all_url | default: routes.collections_url
-%}

<section
  class="bonhomia-collection-list tw-bg-cream"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="tw-flex tw-items-end tw-justify-between tw-flex-wrap tw-gap-4 tw-mb-8">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow tw-mb-2">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="tw-font-serif tw-text-3xl md:tw-text-4xl tw-font-medium tw-text-charcoal tw-m-0">
              {{ section.settings.title | escape }}
            </h2>
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <a href="{{ view_all_href }}" class="btn-ghost">
            {{- section.settings.view_all_label | default: 'Ver todas →' | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="bh-collections-grid tw-grid {{ grid_cols_mobile }} {{ grid_cols_desktop }} tw-list-none tw-p-0 tw-m-0" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = block.settings.collection
          assign card_image = blank
          assign card_alt = coll.title | default: block.settings.title | default: shop.name

          if block.settings.image != blank
            assign card_image = block.settings.image
            if block.settings.image.alt != blank
              assign card_alt = block.settings.image.alt
            endif
          elsif coll != blank and coll.featured_image
            assign card_image = coll.featured_image
            if coll.featured_image.alt != blank
              assign card_alt = coll.featured_image.alt
            endif
          endif
          assign card_alt = card_alt | escape
        -%}
        <li class="tw-m-0" {{ block.shopify_attributes }}>
          <a
            href="{% if coll != blank %}{{ coll.url }}{% else %}{{ view_all_href }}{% endif %}"
            class="bh-collection-card tw-relative tw-block tw-overflow-hidden tw-bg-charcoal tw-group"
          >
            {%- if card_image != blank -%}
              <div class="tw-absolute tw-inset-0 tw-z-0">
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 500, 700, 900, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    class: 'tw-w-full tw-h-full tw-object-cover tw-transition-transform tw-duration-500 group-hover:tw-scale-105',
                    alt: card_alt
                }}
              </div>
            {%- else -%}
              {%- assign ph_idx = forloop.index0 | modulo: 4 | plus: 1 -%}
              {{ 'collection-apparel-' | append: ph_idx | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-cover placeholder-svg' }}
            {%- endif -%}

            <div class="bh-overlay bh-overlay--collection" aria-hidden="true"></div>

            <div class="bh-collection-card__label">
              {%- if coll != blank -%}
                <p class="bh-collection-card__count">
                  {{ coll.all_products_count }}
                  {%- if coll.all_products_count == 1 %} producto{% else %} productos{% endif -%}
                </p>
                <h3 class="bh-collection-card__name">{{ coll.title | escape }}</h3>
              {%- elsif block.settings.title != blank -%}
                <h3 class="bh-collection-card__name">{{ block.settings.title | escape }}</h3>
              {%- else -%}
                <h3 class="bh-collection-card__name">{{ 'onboarding.collection_title' | t }}</h3>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Colecciones Bonhomia",
  "tag": "section",
  "class": "section bonhomia-collection-list-section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Colecciones"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Explora por categoría"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar enlace «Ver todas»",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del enlace",
      "default": "Ver todas →"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "URL del enlace",
      "info": "Vacío = página de todas las colecciones."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columnas en desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de la tarjeta",
          "info": "Opcional. Si la subes, se usa en lugar de la imagen destacada de la colección."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título manual",
          "info": "Solo si no hay colección seleccionada."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones Bonhomia",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}

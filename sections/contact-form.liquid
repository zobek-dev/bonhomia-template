{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="bonhomia-contact-form tw-bg-cream section-{{ section.id }}-padding tw-py-16 md:tw-py-24">
  <div class="tw-max-w-3xl tw-mx-auto tw-px-6">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow tw-mb-4">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="tw-font-serif tw-text-3xl md:tw-text-5xl tw-text-charcoal tw-leading-tight tw-m-0 tw-mb-6">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="tw-font-sans tw-text-base tw-text-taupe tw-leading-relaxed tw-mb-10 tw-max-w-xl">
        {{ section.settings.subheading | escape }}
      </p>
    {%- endif -%}

    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <div class="tw-mb-8 tw-p-4 tw-rounded-sm tw-bg-warm-white tw-border tw-border-border-soft tw-text-charcoal tw-font-sans tw-text-sm" tabindex="-1" autofocus>
          Gracias por escribirnos. Te respondemos a la brevedad.
        </div>
      {%- elsif form.errors -%}
        <div class="tw-mb-8 tw-p-4 tw-rounded-sm tw-bg-warm-white tw-border tw-border-accent tw-text-charcoal tw-font-sans tw-text-sm" role="alert" tabindex="-1" autofocus>
          <p class="tw-m-0 tw-mb-2 tw-font-semibold">Hubo un problema al enviar el formulario.</p>
          <ul class="tw-m-0 tw-pl-5 tw-list-disc">
            {%- for field in form.errors -%}
              <li>
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="tw-grid tw-grid-cols-1 md:tw-grid-cols-2 tw-gap-4 tw-mb-4">
        <div>
          <label for="ContactForm-name" class="tw-block tw-text-xs tw-font-sans tw-font-semibold tw-tracking-tracked tw-uppercase tw-text-taupe tw-mb-2">
            Nombre
          </label>
          <input
            type="text"
            id="ContactForm-name"
            name="contact[name]"
            autocomplete="name"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            class="tw-w-full tw-px-4 tw-py-3 tw-bg-warm-white tw-border tw-border-border-soft tw-rounded-sm tw-text-charcoal tw-font-sans tw-text-base focus:tw-outline-none focus:tw-border-walnut focus:tw-ring-1 focus:tw-ring-walnut"
            placeholder="Tu nombre"
          >
        </div>
        <div>
          <label for="ContactForm-email" class="tw-block tw-text-xs tw-font-sans tw-font-semibold tw-tracking-tracked tw-uppercase tw-text-taupe tw-mb-2">
            Email <span aria-hidden="true" class="tw-text-accent">*</span>
          </label>
          <input
            type="email"
            id="ContactForm-email"
            name="contact[email]"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
            class="tw-w-full tw-px-4 tw-py-3 tw-bg-warm-white tw-border tw-border-border-soft tw-rounded-sm tw-text-charcoal tw-font-sans tw-text-base focus:tw-outline-none focus:tw-border-walnut focus:tw-ring-1 focus:tw-ring-walnut"
            placeholder="tu@email.com"
          >
        </div>
      </div>

      <div class="tw-mb-4">
        <label for="ContactForm-phone" class="tw-block tw-text-xs tw-font-sans tw-font-semibold tw-tracking-tracked tw-uppercase tw-text-taupe tw-mb-2">
          Teléfono
        </label>
        <input
          type="tel"
          id="ContactForm-phone"
          name="contact[phone]"
          autocomplete="tel"
          pattern="[0-9\-\+\s\(\)]*"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          class="tw-w-full tw-px-4 tw-py-3 tw-bg-warm-white tw-border tw-border-border-soft tw-rounded-sm tw-text-charcoal tw-font-sans tw-text-base focus:tw-outline-none focus:tw-border-walnut focus:tw-ring-1 focus:tw-ring-walnut"
          placeholder="+54 9 ..."
        >
      </div>

      <div class="tw-mb-8">
        <label for="ContactForm-body" class="tw-block tw-text-xs tw-font-sans tw-font-semibold tw-tracking-tracked tw-uppercase tw-text-taupe tw-mb-2">
          Mensaje
        </label>
        <textarea
          rows="6"
          id="ContactForm-body"
          name="contact[body]"
          class="tw-w-full tw-px-4 tw-py-3 tw-bg-warm-white tw-border tw-border-border-soft tw-rounded-sm tw-text-charcoal tw-font-sans tw-text-base tw-leading-relaxed focus:tw-outline-none focus:tw-border-walnut focus:tw-ring-1 focus:tw-ring-walnut tw-resize-y"
          placeholder="Cuéntanos en qué podemos ayudarte"
        >{{ form.body }}</textarea>
      </div>

      <div>
        <button type="submit" class="btn-primary tw-w-full md:tw-w-auto">
          {{ section.settings.button_label | default: 'Enviar mensaje' | escape }}
        </button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contacto"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Hablemos"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Cuéntanos sobre tu proyecto, tu espacio o consúltanos por una pieza. Te respondemos en 24-48 horas."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Enviar mensaje"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}

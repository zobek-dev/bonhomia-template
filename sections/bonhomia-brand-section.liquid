{%- liquid
  assign brand_image_alt = section.settings.image.alt | default: section.settings.eyebrow | default: shop.name
  assign brand_image_alt = brand_image_alt | escape
-%}

<section class="bh-brand-section section-{{ section.id }}-padding">
  <div class="bh-brand-section__grid{% if section.settings.image_position == 'right' %} bh-brand-section__grid--reverse{% endif %}">
    <div class="bh-brand-section__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'bh-brand-section__img',
            alt: brand_image_alt
        }}
      {%- else -%}
        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'bh-brand-section__img placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="bh-brand-section__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow tw-mb-4">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.quote != blank -%}
        <blockquote class="bh-brand-section__quote">{{ section.settings.quote }}</blockquote>
      {%- endif -%}

      {%- if section.settings.signature != blank -%}
        <p class="bh-brand-section__signature">{{ section.settings.signature | escape }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="bh-brand-section__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="btn-outline">
          {{- section.settings.cta_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Nuestra historia Bonhomia",
  "tag": "section",
  "class": "section bonhomia-brand-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Nuestra historia"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Cita",
      "default": "<p>\"Creemos que los muebles buenos no sólo decoran; transforman la forma en que vives tu hogar.\"</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Firma",
      "default": "Taller Bonhomia · Santiago de Chile · Desde 2014"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto",
      "default": "<p>Somos un taller artesanal chileno con más de 12 años fabricando muebles que duran décadas. Cada pieza pasa por manos expertas, con maderas nobles seleccionadas y técnicas que combinan tradición y diseño contemporáneo.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón",
      "default": "Conocer más"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "URL del botón"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Nuestra historia Bonhomia"
    }
  ]
}
{% endschema %}

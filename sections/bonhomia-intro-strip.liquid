<div class="bh-intro-strip">
  <div class="bh-intro-strip__grid">
    {%- for block in section.blocks -%}
      <div class="bh-intro-strip__item" {{ block.shopify_attributes }}>
        <span class="bh-intro-strip__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'leaf' -%}{% render 'bonhomia-icon-leaf' %}
            {%- when 'hammer' -%}{% render 'bonhomia-icon-hammer' %}
            {%- when 'ruler' -%}{% render 'bonhomia-icon-ruler' %}
            {%- when 'truck' -%}{% render 'bonhomia-icon-truck' %}
            {%- when 'tree' -%}{% render 'bonhomia-icon-tree' %}
            {%- when 'shield' -%}{% render 'bonhomia-icon-shield' %}
            {%- when 'chat' -%}{% render 'bonhomia-icon-chat' %}
            {%- else -%}{% render 'bonhomia-icon-leaf' %}
          {%- endcase -%}
        </span>
        <p class="bh-intro-strip__text">
          {%- if block.settings.title != blank -%}
            <strong>{{ block.settings.title | escape }}</strong>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            {{ ' ' }}{{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bonhomia Intro Strip",
  "tag": "section",
  "class": "section bonhomia-intro-strip",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "leaf", "label": "Madera / hoja" },
            { "value": "hammer", "label": "Martillo / taller" },
            { "value": "ruler", "label": "Regla / a medida" },
            { "value": "truck", "label": "Camión / despacho" },
            { "value": "tree", "label": "Árbol / sustentable" },
            { "value": "shield", "label": "Escudo / garantía" },
            { "value": "chat", "label": "Chat / asesoría" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Madera maciza"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "seleccionada a mano"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bonhomia Intro Strip",
      "blocks": [
        { "type": "feature", "settings": { "icon": "leaf", "title": "Madera maciza", "text": "seleccionada a mano" } },
        { "type": "feature", "settings": { "icon": "hammer", "title": "Fabricación artesanal", "text": "en Chile" } },
        { "type": "feature", "settings": { "icon": "ruler", "title": "Personalización", "text": "a tu medida exacta" } },
        { "type": "feature", "settings": { "icon": "truck", "title": "Despacho", "text": "a todo Chile" } }
      ]
    }
  ]
}
{% endschema %}

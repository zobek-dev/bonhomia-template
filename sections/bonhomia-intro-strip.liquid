{%- liquid
  assign bg = section.settings.background_color | default: 'warm-white'
-%}

<section class="tw-bg-{{ bg }} tw-border-y tw-border-border-soft">
  <div class="page-width !tw-py-10 md:!tw-py-14">
    <div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-8 md:tw-gap-10">
      {%- for block in section.blocks -%}
        <div class="tw-flex tw-items-start tw-gap-4" {{ block.shopify_attributes }}>
          <span class="tw-flex-shrink-0 tw-flex tw-items-center tw-justify-center tw-w-10 tw-h-10 tw-rounded-pill tw-bg-cream tw-text-walnut">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}{% render 'bonhomia-icon-leaf' %}
              {%- when 'hammer' -%}{% render 'bonhomia-icon-hammer' %}
              {%- when 'ruler' -%}{% render 'bonhomia-icon-ruler' %}
              {%- when 'truck' -%}{% render 'bonhomia-icon-truck' %}
              {%- when 'tree' -%}{% render 'bonhomia-icon-tree' %}
              {%- when 'shield' -%}{% render 'bonhomia-icon-shield' %}
              {%- when 'chat' -%}{% render 'bonhomia-icon-chat' %}
              {%- else -%}{% render 'bonhomia-icon-leaf' %}
            {%- endcase -%}
          </span>
          <div class="tw-text-sm tw-leading-relaxed">
            {%- if block.settings.title != blank -%}
              <p class="tw-font-sans tw-font-semibold tw-text-charcoal tw-mb-1">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="tw-font-sans tw-text-taupe tw-text-sm">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bonhomia Intro Strip",
  "tag": "section",
  "class": "section bonhomia-intro-strip",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "background_color",
      "label": "Fondo",
      "options": [
        { "value": "warm-white", "label": "Warm white" },
        { "value": "cream", "label": "Cream" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "warm-white"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "leaf", "label": "Madera / hoja" },
            { "value": "hammer", "label": "Martillo / taller" },
            { "value": "ruler", "label": "Regla / a medida" },
            { "value": "truck", "label": "Camión / despacho" },
            { "value": "tree", "label": "Árbol / sustentable" },
            { "value": "shield", "label": "Escudo / garantía" },
            { "value": "chat", "label": "Chat / asesoría" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Madera maciza"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "seleccionada a mano"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bonhomia Intro Strip",
      "blocks": [
        { "type": "feature", "settings": { "icon": "leaf", "title": "Madera maciza", "text": "seleccionada a mano" } },
        { "type": "feature", "settings": { "icon": "hammer", "title": "Fabricación artesanal", "text": "en Chile" } },
        { "type": "feature", "settings": { "icon": "ruler", "title": "Personalización", "text": "a tu medida exacta" } },
        { "type": "feature", "settings": { "icon": "truck", "title": "Despacho", "text": "a todo Chile" } }
      ]
    }
  ]
}
{% endschema %}

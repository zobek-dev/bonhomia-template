{%- comment -%} Bonhomia re-skin — Dawn component CSS no longer required for the card itself,
but quick_add scripts are still loaded conditionally for back-compat with legacy instances. {%- endcomment -%}
{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign products_to_display = section.settings.collection.all_products_count
  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign cols = section.settings.columns_desktop | default: 4
  assign grid_cols_desktop = 'lg:tw-grid-cols-4'
  case cols
    when 1
      assign grid_cols_desktop = 'lg:tw-grid-cols-1'
    when 2
      assign grid_cols_desktop = 'lg:tw-grid-cols-2'
    when 3
      assign grid_cols_desktop = 'lg:tw-grid-cols-3'
    when 4
      assign grid_cols_desktop = 'lg:tw-grid-cols-4'
    when 5
      assign grid_cols_desktop = 'lg:tw-grid-cols-5'
    when 6
      assign grid_cols_desktop = 'lg:tw-grid-cols-6'
  endcase
  assign grid_cols_mobile = 'tw-grid-cols-2'
  if section.settings.columns_mobile == '1'
    assign grid_cols_mobile = 'tw-grid-cols-1'
  endif
-%}

<section
  class="bonhomia-featured-collection tw-bg-cream"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  id="collection-{{ section.id }}"
>
  <div class="page-width">
    <div class="tw-flex tw-items-end tw-justify-between tw-flex-wrap tw-gap-4 tw-mb-10">
      <div>
        <p class="eyebrow tw-mb-2">Destacados</p>
        {%- if section.settings.title != blank -%}
          <h2 class="tw-font-serif tw-text-3xl md:tw-text-4xl tw-font-medium tw-text-charcoal tw-m-0">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank or section.settings.show_description and section.settings.collection.description != empty -%}
          <div class="tw-mt-3 tw-font-sans tw-text-sm tw-text-taupe tw-max-w-2xl">
            {%- if section.settings.show_description -%}
              {{ section.settings.collection.description }}
            {%- else -%}
              {{ section.settings.description }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="btn-ghost">Ver todo →</a>
      {%- endif -%}
    </div>

    <ul class="tw-grid {{ grid_cols_mobile }} md:tw-grid-cols-3 {{ grid_cols_desktop }} tw-gap-6 tw-list-none tw-p-0 tw-m-0" role="list">
      {%- if section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li class="tw-m-0">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: section.settings.image_shape,
              lazy_load: forloop.index > cols,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              section_id: section.id,
              quick_add: section.settings.quick_add
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns_desktop) -%}
          {%- assign ridx = forloop.rindex -%}
          {%- if ridx > 4 -%}{%- assign ridx = ridx | modulo: 4 | plus: 1 -%}{%- endif -%}
          {%- assign placeholder_image = 'product-apparel-' | append: ridx -%}
          <li class="tw-m-0">
            {% render 'card-product',
              show_vendor: section.settings.show_vendor,
              media_aspect_ratio: section.settings.image_ratio,
              placeholder_image: placeholder_image
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all and more_in_collection -%}
      <div class="tw-mt-12 tw-flex tw-justify-center">
        <a href="{{ section.settings.collection.url }}" class="btn-outline">
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}

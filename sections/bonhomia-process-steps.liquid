{%- liquid
  assign bg = section.settings.background_color | default: 'warm-white'
-%}

<section class="bonhomia-process-steps tw-bg-{{ bg }}">
  <div class="tw-max-w-6xl tw-mx-auto tw-px-6 md:tw-px-12 tw-py-14 md:tw-py-20">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tw-text-xs tw-font-sans tw-font-semibold tw-tracking-tracked-lg tw-uppercase tw-text-taupe tw-mb-3 tw-text-center">
        {{- section.settings.eyebrow | escape -}}
      </p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="tw-font-serif tw-text-3xl md:tw-text-4xl tw-text-charcoal tw-leading-tight tw-text-center tw-m-0 tw-mb-10 md:tw-mb-14">
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}

    <ol class="tw-list-none tw-p-0 tw-m-0 tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-3 tw-gap-6 md:tw-gap-8">
      {%- for block in section.blocks -%}
        <li class="tw-flex tw-items-start tw-gap-4" {{ block.shopify_attributes }}>
          <span class="tw-flex-shrink-0 tw-flex tw-items-center tw-justify-center tw-w-10 tw-h-10 tw-rounded-pill tw-bg-cream tw-text-walnut tw-font-serif tw-text-lg tw-font-semibold">
            {{- block.settings.number | default: forloop.index -}}
          </span>
          <div class="tw-flex-1">
            {%- if block.settings.title != blank -%}
              <p class="tw-text-base tw-font-sans tw-font-semibold tw-text-charcoal tw-m-0 tw-mb-1">
                {{- block.settings.title | escape -}}
              </p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="tw-text-sm tw-text-taupe tw-leading-relaxed tw-m-0">
                {{- block.settings.text | escape -}}
              </p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Proceso (timeline)",
  "tag": "section",
  "class": "section bonhomia-process-steps-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Cómo funciona"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Del pedido al living"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Fondo",
      "options": [
        { "value": "warm-white", "label": "Warm white" },
        { "value": "cream", "label": "Cream" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "warm-white"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Número (opcional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Completás el formulario"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Descripción",
          "default": "Dimensiones, material, acabado y comentarios."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Proceso (timeline)",
      "blocks": [
        { "type": "step", "settings": { "title": "Completás el formulario", "text": "Dimensiones, material, acabado y comentarios." } },
        { "type": "step", "settings": { "title": "Recibís la cotización", "text": "En 24-48 horas por email con precio y tiempos." } },
        { "type": "step", "settings": { "title": "Aprobás y pagás la seña", "text": "30% para iniciar la fabricación." } },
        { "type": "step", "settings": { "title": "Seguimiento en tiempo real", "text": "Te avisamos en cada etapa de fabricación." } },
        { "type": "step", "settings": { "title": "Entrega y saldo final", "text": "Pagás el saldo al recibir el mueble." } }
      ]
    }
  ]
}
{% endschema %}

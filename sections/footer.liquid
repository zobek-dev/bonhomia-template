<footer class="bh-footer section-{{ section.id }}-padding">
  <div class="bh-footer__inner">
    <div class="bh-footer__grid">
      <div class="bh-footer__brand">
        <a href="{{ section.settings.logo_url | default: routes.root_url }}" class="bh-footer__logo-link">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 280
              | image_tag:
                class: 'bh-footer__logo-image',
                widths: '140, 200, 280',
                alt: section.settings.logo.alt | default: shop.name,
                loading: 'lazy'
            }}
          {%- elsif section.settings.logo_text != blank -%}
            <span class="bh-footer__logo">{{ section.settings.logo_text | escape }}</span>
          {%- else -%}
            <span class="bh-footer__logo">{{ shop.name | escape }}.</span>
          {%- endif -%}
        </a>

        {%- if section.settings.description != blank -%}
          <div class="bh-footer__desc">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign menu_heading = section.settings.menu_1_heading
              assign menu = section.settings.menu_1
            when 2
              assign menu_heading = section.settings.menu_2_heading
              assign menu = section.settings.menu_2
            when 3
              assign menu_heading = section.settings.menu_3_heading
              assign menu = section.settings.menu_3
          endcase
        -%}
        {%- if menu_heading != blank or menu != blank -%}
          <div class="bh-footer__col">
            {%- if menu_heading != blank -%}
              <p class="bh-footer__col-title">{{ menu_heading | escape }}</p>
            {%- endif -%}
            {%- if menu != blank and menu.links.size > 0 -%}
              <ul class="bh-footer__links">
                {%- for link in menu.links -%}
                  <li>
                    <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                      {{ link.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="bh-footer__bottom">
      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.
        {%- if section.settings.copyright_note != blank -%}
          {{ ' ' }}{{ section.settings.copyright_note | escape }}
        {%- endif -%}
      </span>
      {%- if section.settings.bottom_tagline != blank -%}
        <span>{{ section.settings.bottom_tagline | escape }}</span>
      {%- endif -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endif -%}
  {%- endfor -%}
</footer>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Footer Bonhomia",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Marca"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (imagen)"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo (texto)",
      "default": "Bonhomia.",
      "info": "Se muestra si no subes una imagen de logo."
    },
    {
      "type": "url",
      "id": "logo_url",
      "label": "Enlace del logo"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Muebles artesanales de alta calidad, fabricados en Chile con maderas nobles y diseño atemporal.</p>"
    },
    {
      "type": "header",
      "content": "Columna Tienda"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Título",
      "default": "Tienda"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menú",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Columna Ayuda"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Título",
      "default": "Ayuda"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menú",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Columna Empresa"
    },
    {
      "type": "text",
      "id": "menu_3_heading",
      "label": "Título",
      "default": "Empresa"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menú",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Barra inferior"
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Nota de copyright",
      "default": "Todos los derechos reservados."
    },
    {
      "type": "text",
      "id": "bottom_tagline",
      "label": "Texto inferior derecho",
      "default": "Diseño artesanal · Hecho en Chile"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 32
    }
  ]
}
{% endschema %}

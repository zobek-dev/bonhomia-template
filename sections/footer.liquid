<footer class="bh-footer section-{{ section.id }}-padding">
  <div class="bh-footer__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="bh-footer__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- when 'text' -%}
              <div class="bh-footer__brand" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <div class="bh-footer__logo">{{ block.settings.heading }}</div>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <div class="bh-footer__desc">{{ block.settings.subtext }}</div>
                {%- endif -%}
              </div>
            {%- when 'link_list' -%}
              <div class="bh-footer__col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="bh-footer__col-title">{{ block.settings.heading | escape }}</p>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="bh-footer__links">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- when 'brand_information' -%}
              <div class="bh-footer__brand" {{ block.shopify_attributes }}>
                {%- if settings.brand_headline != blank -%}
                  <div class="bh-footer__logo">{{ settings.brand_headline }}</div>
                {%- endif -%}
                {%- if settings.brand_description != blank -%}
                  <div class="bh-footer__desc">{{ settings.brand_description }}</div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="bh-footer__bottom">
      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.
        {%- if section.settings.copyright_note != blank -%}
          {{ ' ' }}{{ section.settings.copyright_note | escape }}
        {%- endif -%}
      </span>
      {%- if section.settings.bottom_tagline != blank -%}
        <span>{{ section.settings.bottom_tagline | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Enlaces",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Bonhomia.",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Muebles artesanales de alta calidad, fabricados en Chile con maderas nobles y diseño atemporal.</p>",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "copyright_note",
      "label": "Nota de copyright",
      "default": "Todos los derechos reservados."
    },
    {
      "type": "text",
      "id": "bottom_tagline",
      "label": "Texto inferior derecho",
      "default": "Diseño artesanal · Hecho en Chile"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "text"
      },
      {
        "type": "link_list"
      },
      {
        "type": "link_list"
      },
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
